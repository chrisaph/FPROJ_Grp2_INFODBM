@page "{id}"
@model FPROJ_Grp2_INFODBM_BTIS2.Pages.Admin.ReviewModel

<h2>Applicant Review</h2>

@if (Model.Student != null)
{
    <h4>Personal Information</h4>

    <table class="table table-bordered">

        <tr>
            <th>Student ID</th>
            <td>@Model.Student.StudId</td>
        </tr>

        <tr>
            <th>Name</th>
            <td>
                @Model.Student.LName,
                @Model.Student.FName
                @Model.Student.MName
            </td>
        </tr>

        <tr>
            <th>Date of Birth</th>
            <td>@(Model.Student.DateOfBirth?.ToString("MMMM dd, yyyy") ?? "N/A")</td>
        </tr>

        <tr>
            <th>Address</th>
            <td>@Model.Student.Address</td>
        </tr>

        <tr>
            <th>Email</th>
            <td>@Model.Student.Email</td>
        </tr>

        <tr>
            <th>Hobbies</th>
            <td>@Model.Student.Hobbies</td>
        </tr>

    </table>

    <h4>Academic Information</h4>

    <table class="table table-bordered">

        <tr>
            <th>School</th>
            <td>@Model.Student.Degree?.School?.SchoolName</td>
        </tr>

        <tr>
            <th>Degree</th>
            <td>@Model.Student.Degree?.DName</td>
        </tr>

        <tr>
            <th>Scholarship</th>
            <td>@Model.Student.Scholarship?.SSType</td>
        </tr>

        <tr>
            <th>Applicant Type</th>
            <td>@Model.Student.ApplicantType?.AplType</td>
        </tr>

    </table>

    <h4>Application Information</h4>

    <table class="table table-bordered">

        <tr>
            <th>Status</th>
            <td>@Model.Student.Status</td>
        </tr>

        <tr>
            <th>Remarks</th>
            <td>@Model.Student.Remarks</td>
        </tr>

        <tr>
            <th>Portfolio</th>
            <td>
                @if (Model.Portfolio != null)
                {
                    <a href="@Model.Portfolio.PortfolioLink" target="_blank">
                        View Portfolio
                    </a>
                }
            </td>
        </tr>

    </table>

    <h4>Position Choices</h4>

    <table class="table table-bordered">

        <thead>
            <tr>
                <th>Rank</th>
                <th>Position</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var c in Model.Choices)
            {
                <tr>
                    <td>@c.Rank</td>
                    <td>@c.ChoiceName</td>
                </tr>
            }

        </tbody>

    </table>

    <form method="post">

        <div class="mb-3">
            <label class="form-label">Remarks</label>
            <textarea asp-for="Remarks"
                      class="form-control"
                      rows="3"></textarea>
        </div>

        <input type="hidden" asp-for="Id" />

        <button asp-page-handler="Approve"
                class="btn btn-success">
            Approve
        </button>

        <button asp-page-handler="Waitlist"
                class="btn btn-warning">
            Waitlist
        </button>

        <button asp-page-handler="Decline"
                class="btn btn-danger">
            Decline
        </button>

    </form>
}