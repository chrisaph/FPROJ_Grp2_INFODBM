@page
@model FPROJ_Grp2_INFODBM_BTIS2.Pages.Admin.ApplicationsModel

<h2>Applications</h2>

<table class="table table-striped">

    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Degree</th>
            <th>School</th>
            <th>Applicant Type</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>

    <tbody>

        @foreach (var a in Model.Applicants)
        {
            <tr>

                <td>@a.StudId</td>

                <td>@a.LName, @a.FName</td>

                <td>@a.Degree</td>

                <td>@a.School</td>

                <td>@a.ApplicantType</td>

                <td>@a.Status</td>

                <td>

                    <a asp-page="Review"
                       asp-route-id="@a.StudId"
                       class="btn btn-primary">

                        Review

                    </a>

                </td>

            </tr>
        }

    </tbody>
    <a asp-page="/Admin/Logout"
       class="btn btn-outline-danger float-end">
        Logout
    </a>
</table>