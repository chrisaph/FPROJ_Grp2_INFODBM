@page
@model IndexModel

@{
    ViewData["Title"] = "Home";
}

<div class="text-center mt-5">

    <h1 class="display-4">
        Recruitment Application Database System
    </h1>

    <p class="lead">
        Benildean Press Corps Recruitment Portal
    </p>

    <br />

    <a asp-page="/Applicant/VerifyStudent"
       class="btn btn-primary btn-lg px-5 py-3">
        Apply
    </a>

    <p class="mt-3">
        Apply for the Benildean Press Corps.
    </p>

    <hr class="my-5" />

    <a asp-page="/Admin/Login"
       class="btn btn-dark btn-lg px-5 py-3">
        Applicants
    </a>

    <p class="mt-3">
        For Benildean Press Corps Officers
    </p>

</div>