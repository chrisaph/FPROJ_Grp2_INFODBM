@page
@model FPROJ_Grp2_INFODBM_BTIS2.Pages.Applicant.AppFormModel

@{
    ViewData["Title"] = "Application Form";
}

<h2>Application Form</h2>

<form method="post">

    <input asp-for="Student.StudId" type="hidden" />
    <div class="mb-3">
        <label>Status</label>
        <input class="form-control"
               value="@Model.Student?.Status"
               readonly />
    </div>
    <div class="mb-3">
        <label>First Name</label>
        <input asp-for="Student.FName" class="form-control"
               readonly="@Model.IsReadOnly" />
    </div>

    <div class="mb-3">
        <label>Middle Name</label>
        <input asp-for="Student.MName" class="form-control"
               readonly="@Model.IsReadOnly" />
    </div>

    <div class="mb-3">
        <label>Last Name</label>
        <input asp-for="Student.LName" class="form-control"
               readonly="@Model.IsReadOnly" />
    </div>

    <div class="mb-3">
        <label>Degree</label>
        <select asp-for="Student.Did"
                asp-items="Model.Degrees"
                class="form-select"
                disabled="@Model.IsReadOnly">
        </select>
    </div>

    <div class="mb-3">
        <label>Scholarship</label>
        <select asp-for="Student.Ssid"
                asp-items="Model.Scholarships"
                class="form-select"
                disabled="@Model.IsReadOnly">
        </select>
    </div>

    <div class="mb-3">
        <label>Applicant Type</label>
        <select asp-for="Student.Aplid"
                asp-items="Model.Applicant_Type"
                class="form-select"
                disabled="@Model.IsReadOnly">
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="Student.DateOfBirth" class="form-control"></label>
        <input asp-for="Student.DateOfBirth"
               type="date"
               class="form-control"
               readonly="@Model.IsReadOnly" />
    </div>
    <div class="mb-3">
        <label asp-for="Student.Address" class="form-control"></label>
        <input asp-for="Student.Address"
               class="form-control"
               readonly="@Model.IsReadOnly" />
    </div>
    <div class="mb-3">
        <label asp-for="Student.Email" class="form-control"></label>
        <input asp-for="Student.Email"
               type="email"
               class="form-control"
               readonly="@Model.IsReadOnly" />
    </div>
    <div class="mb-3">
        <label asp-for="Student.Hobbies" class="form-control"
               readonly="@Model.IsReadOnly"></label>
        <textarea asp-for="Student.Hobbies"
                  class="form-control"
                  rows="3" readonly="@Model.IsReadOnly"></textarea>
    </div>

    <div class="mb-3">
        <label>Portfolio Link</label>
        <input asp-for="PortfolioLink" class="form-control"
               readonly="@Model.IsReadOnly" />
    </div>

    <div class="mb-3">
        <label>1st Choice</label>
        <select asp-for="Choice1"
                asp-items="Model.Positions"
                class="form-select"
                disabled="@Model.IsReadOnly">
        </select>
    </div>

    <div class="mb-3">
        <label>2nd Choice</label>
        <select asp-for="Choice2"
                asp-items="Model.Positions"
                class="form-select"
                disabled="@Model.IsReadOnly">
        </select>
    </div>

    <div class="mb-3">
        <label>3rd Choice</label>
        <select asp-for="Choice3"
                asp-items="Model.Positions"
                class="form-select"
                disabled="@Model.IsReadOnly">
        </select>
    </div>

    <button class="btn btn-success"
            disabled="@Model.IsReadOnly">
        Apply
    </button>

    @if (Model.IsReadOnly)
    {
        <div class="alert alert-warning">

            <strong>
                This application has already been
                @Model.Student.Status.
            </strong>

            Editing has been disabled.

        </div>
    }

</form>